# Groq inference
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Supabase authentication validation
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Keep this aligned with the private Supabase datasets bucket limit
MAX_UPLOAD_MB=50

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Apply supabase migrations before enabling cloud persistence.
# memory = demo only; sqlite = persistent local development; supabase = cloud.
DAISY_PERSISTENCE=memory
# Production refuses memory persistence. Choose sqlite or supabase first.
DAISY_ENV=development
# Shared DataFrame cache; active request/worker frames are protected from eviction.
DAISY_CACHE_MB=512
# Set a unique ID for each worker when running multiple workers on one host.
# DAISY_WORKER_ID=worker-1
# DAISY_STATE_DB=state/daisy.sqlite
